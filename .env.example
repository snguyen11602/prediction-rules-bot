# Copy to .env — none of these are required for scan/watch/paper/demo.

# Optional poll interval for `npm run watch` (seconds)
POLL_INTERVAL_SEC=60

# Optional event sinks
# WEBHOOK_URL=https://example.com/hooks/prediction-rules
# EVENT_LOG_FILE=data/events.jsonl

# Optional API base overrides (public reads)
# KALSHI_API_BASE=https://api.elections.kalshi.com/trade-api/v2
# POLYMARKET_US_BASE=https://gateway.polymarket.us
# POLYMARKET_GAMMA_BASE=https://gamma-api.polymarket.com

# Polymarket US order books read per scan for liquidity (one request each)
# POLYMARKET_US_BOOKS=100

# --- LIVE TRADING (intentionally unused by this starter) ---
# All three must be set/passed for any future live path; order code is still stubbed.
# ENABLE_LIVE_TRADING=true
# ALLOW_LIVE=true
# Plus CLI: npm run live -- --i-understand-live

# --- API keys: only used by `npm run paper:fast` to sign READ-ONLY price streams ---
# Nothing in this repo places orders with them. Keep this file local (.env is gitignored).

# Kalshi (account settings → API Keys): key id + path to the downloaded private key file
# KALSHI_API_KEY_ID=
# KALSHI_PRIVATE_KEY_PATH=

# Polymarket US (polymarket.us/developer): Key ID + Secret Key
# POLYMARKET_KEY_ID=
# POLYMARKET_SECRET_KEY=

# --- Sharp sportsbook lines (rules with entry.sharp_edge) ---
# Free key from https://the-odds-api.com (500 requests a month). Read-only odds; keep it local.
# ODDS_API_KEY=

# --- Phone alerts: paper trades, exits and pauses sent to a chat webhook ---
# A Discord channel webhook, a Slack incoming webhook, an ntfy.sh topic URL, or any URL that takes JSON.
# Treat the URL like a password: anyone who has it can post to your channel.
# ALERT_WEBHOOK_URL=
# Which alerts (default trades,exits,pauses; also signals, problems, or all):
# ALERT_EVENTS=trades,exits,pauses
# Only these strategies (default: all), e.g. arbitrage,late-mover-paper,sharp-line-paper:
# ALERT_RULES=
