{
  "name": "prediction-rules-bot",
  "version": "0.1.0",
  "description": "Shared rules engine for Kalshi and Polymarket prediction markets (alerts/paper first; live gated)",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "scan": "tsx src/cli/scan.ts",
    "watch": "tsx src/cli/watch.ts",
    "paper": "tsx src/cli/paper.ts",
    "paper:report": "tsx src/cli/paper-report.ts",
    "paper:close": "tsx src/cli/paper-close.ts",
    "paper:watch": "tsx src/cli/dashboard.ts --paper",
    "dashboard": "tsx src/cli/dashboard.ts",
    "live": "tsx src/cli/live.ts",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "arb:find": "tsx src/cli/arb.ts find",
    "arb:confirm": "tsx src/cli/arb.ts confirm",
    "arb:block": "tsx src/cli/arb.ts block"
  },
  "dependencies": {
    "yaml": "^2.7.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
